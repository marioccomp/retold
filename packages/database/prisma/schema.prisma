// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  RECRUITER
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

model User {
  id            Int       @id @default(autoincrement())
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  githubEmail   String?
  phone         String?
  name          String?
  title         String?
  image         String?
  cover         String?
  bio           String?
  longBio       String?
  skills        String[]  @default([])
  githubUrl     String?
  linkedinUrl   String?
  websiteUrl    String?
  contactEmail  String? // Public contact email, separate from account email
  password      String? // null when OAuth
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  sessionVersion Int      @default(0)

  passwordResetTokens PasswordResetToken[]
  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  certifications      Certification[]
  participations      Participation[]
  educations          Education[]
  likes               Like[]
  projectViews        ProjectView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  githubInstallations GithubAppInstallation[]

  rateLimitResetAt DateTime?

  hasCompletedOnboarding Boolean @default(false)

  dailyAnalysisCount Int       @default(0)
  dailyAnalysisDate  DateTime?

  repositories Repository[]

  followers Follows[] @relation("following")
  following Follows[] @relation("follower")

  githubStats GithubStats?
  userStats   UserProjectStats[]
  comments    Comment[]

  notifications     Notification[] @relation("ReceivedNotifications")
  sentNotifications Notification[] @relation("SentNotifications")

  projectCollaborations  ProjectCollaborator[] @relation("ProjectCollaborations")
  sentProjectInvitations ProjectCollaborator[] @relation("SentProjectInvitations")

  @@index([email])
  @@index([username])
}

model GithubStats {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastCommit          Json?
  lastCommitFetchedAt DateTime?
  totalStars          Int
  totalRepositories   Int
  totalPRs            Int
  topLanguages        Json?
  updatedAt           DateTime? @updatedAt
}

// Estatísticas detalhadas do usuário em relação a um projeto específico
model UserProjectStats {
  id Int @id @default(autoincrement())

  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Métricas de Código
  commitsCount Int @default(0) // Quantidade de commits do usuário
  linesAdded   Int @default(0) // Linhas adicionadas (via git log)
  linesDeleted Int @default(0) // Linhas deletadas (via git log)

  // Métricas de Tempo/Frequência
  firstCommitDate DateTime? // Data do primeiro commit nesse projeto
  lastCommitDate  DateTime? // Data do último commit nesse projeto
  activeDays      Int       @default(0) // Quantos dias diferentes o usuário commitou
  activeDates     String[]  @default([]) // Dias ativos ("YYYY-MM-DD"), para contar dias distintos entre projetos

  // Métricas de Impacto
  impactScore Float @default(0) // Um score calculado (ex: complexidade * volume) - futuro

  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Follows {
  follower    User     @relation("follower", fields: [followerId], references: [id])
  followerId  Int
  following   User     @relation("following", fields: [followingId], references: [id])
  followingId Int
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model GithubAppInstallation {
  id             Int    @id @default(autoincrement())
  installationId String @unique
  accountLogin   String
  accountType    String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime? // Null = Ativo, DateTime = Usado

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ProjectStatus {
  PENDING
  ANALYZING
  DONE
  ERROR
  RATE_LIMITED
}

model Project {
  id                Int    @id @default(autoincrement())
  title             String
  description       String
  longerDescription String

  images         String[]
  featuredTagIds Int[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repositoryId Int?
  repository   Repository? @relation(fields: [repositoryId], references: [id])

  isPinned Boolean @default(false)

  visibility String @default("public") // "public" | "private"

  status   ProjectStatus       @default(PENDING)
  analysis RepositoryAnalysis?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tags Tag[]

  likes        Like[]
  views        Int           @default(0)
  projectViews ProjectView[]

  userStats UserProjectStats[]
  comments  Comment[]
  notifications Notification[]
  collaborators ProjectCollaborator[]
  analysisRuns   AnalysisRun[]
  analysisClaims AnalysisClaim[]
  scores         ProjectScore[]
}

enum ProjectCollaboratorStatus {
  PENDING
  ACCEPTED
}

// Membros de um projeto além do dono (Project.userId). O dono convida pelo username;
// o convite só vale depois de aceito. Recusar ou sair apaga a linha.
model ProjectCollaborator {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation("ProjectCollaborations", fields: [userId], references: [id], onDelete: Cascade)

  invitedById Int
  invitedBy   User @relation("SentProjectInvitations", fields: [invitedById], references: [id], onDelete: Cascade)

  status      ProjectCollaboratorStatus @default(PENDING)
  createdAt   DateTime                  @default(now())
  respondedAt DateTime?

  @@unique([projectId, userId])
  @@index([userId, status])
}

model Like {
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Chave composta para garantir que um usuário só pode curtir um projeto uma vez
  @@id([userId, projectId])
  // Index para contar likes de um projeto rapidamente
  @@index([projectId])
}

model Repository {
  id Int @id @default(autoincrement())

  githubId Int    @unique
  name     String
  fullName String
  url      String

  private Boolean

  isActive Boolean @default(true)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RepositoryAnalysis {
  id Int @id @default(autoincrement())

  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  appType     String
  stack       Json
  structure   Json?
  signals     Json?
  rawAnalysis Json?
  llmOverview String? @db.Text
  // Mapa determinístico do repositório (módulos, arquivos centrais, higiene, maturidade medida).
  // Ver services/worker/analyze/repo-map. Fase 1 do docs/analysis-roadmap.md.
  repoMap     Json?

  createdAt DateTime @default(now())
}

// Uma execução da análise em duas etapas (Fase 2 do docs/analysis-roadmap.md):
// modelo, commit analisado, tokens e resultado, para comparar versões e custos.
enum AnalysisRunStatus {
  DONE
  ERROR
}

model AnalysisRun {
  id Int @id @default(autoincrement())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  pipelineVersion String
  provider        String
  model           String
  commitSha       String?
  privacyMode     String
  status          AnalysisRunStatus

  llmCalls     Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  // Só preenchido quando LLM_PRICE_INPUT_PER_MTOK / LLM_PRICE_OUTPUT_PER_MTOK estão configurados.
  costUsd      Decimal? @db.Decimal(10, 6)
  durationMs   Int?
  // Unidades lidas, afirmações rejeitadas/refutadas, chamadas.
  stats        Json?
  error        String?  @db.Text

  createdAt DateTime @default(now())

  claims AnalysisClaim[]
  scores ProjectScore[]

  @@index([projectId, createdAt])
}

enum AnalysisClaimKind {
  RESPONSIBILITY
  PATTERN
  NOTABLE
  RISK
}

// Afirmação sobre o código que passou pelo validador (arquivo + linhas + símbolo).
model AnalysisClaim {
  id Int @id @default(autoincrement())

  runId Int
  run   AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Id usado nos prompts e nas referências do llmOverview ("c3").
  key       String
  module    String
  kind      AnalysisClaimKind
  text      String            @db.Text
  filePath  String
  startLine Int
  endLine   Int
  symbol    String
  // "verified" ou "reanchored" (o símbolo estava em outra linha do mesmo arquivo).
  location  String
  // Confirmada pela segunda checagem com o LLM.
  checked   Boolean           @default(false)

  @@unique([runId, key])
  @@index([projectId])
}

enum ScoreAxis {
  ARCHITECTURE
  SECURITY
  TESTING
  DEVOPS
  DOCUMENTATION
}

model ProjectScore {
  id Int @id @default(autoincrement())

  runId Int
  run   AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  axis      ScoreAxis
  // 0–100.
  score     Int
  // "measured" (maturidade do repo map) ou "llm" (exige afirmação verificada).
  source    String
  rationale String    @db.Text
  evidence  Json

  @@unique([runId, axis])
  @@index([projectId, axis])
}

model Certification {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  issuer        String
  credentialUrl String?
  issuedAt      DateTime

  image String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tags Tag[]
}

model Participation {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  images String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tags Tag[]
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  projects       Project[]
  certifications Certification[]
  participations Participation[]
}

model Education {
  id          Int       @id @default(autoincrement())
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime? // Null means "In Progress"

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProjectView {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String? // Para usuários não logados
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([projectId, userId])
  @@index([projectId, ipAddress])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  notifications Notification[]

  @@index([projectId])
  @@index([userId])
}

enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  PROJECT_INVITE
  PROJECT_INVITE_ACCEPTED
}

model Notification {
  id           Int              @id @default(autoincrement())
  userId       Int
  user         User             @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type         NotificationType
  sourceUserId Int
  sourceUser   User             @relation("SentNotifications", fields: [sourceUserId], references: [id], onDelete: Cascade)
  projectId    Int?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commentId    Int?
  comment      Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([sourceUserId])
  @@index([projectId])
  @@index([commentId])
}
