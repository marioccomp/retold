generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  username String @unique
  email String @unique
  name  String
  password String
  isRecruiter Boolean @default(false)
  projects Project[]
}

model Project {
  id Int @id @default(autoincrement())
  title String
  description String
  longerDescription String
  createdAt DateTime @default(now())

  userId Int
  user User @relation(fields:[userId], references: [id])

  tags Tag[]
}

model Tag {
  id Int @id @default(autoincrement())
  name String @unique
  projects Project[]
}
