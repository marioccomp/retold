// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  RECRUITER
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

model User {
  id            Int       @id @default(autoincrement())
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  githubEmail   String?
  phone         String?
  name          String?
  title         String?
  image         String?
  cover         String?
  bio           String?
  longBio       String?
  skills        String[]  @default([])
  githubUrl     String?
  linkedinUrl   String?
  websiteUrl    String?
  contactEmail  String? // Public contact email, separate from account email
  password      String? // null when OAuth
  role          Role      @default(USER)
  plan          Plan      @default(FREE)

  passwordResetTokens PasswordResetToken[]
  accounts            Account[]
  sessions            Session[]
  projects            Project[]
  certifications      Certification[]
  participations      Participation[]
  educations          Education[]
  likes               Like[]
  projectViews        ProjectView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  githubInstallations GithubAppInstallation[]

  rateLimitResetAt DateTime?

  dailyAnalysisCount Int       @default(0)
  dailyAnalysisDate  DateTime?

  repositories Repository[]

  followers Follows[] @relation("following")
  following Follows[] @relation("follower")

  githubStats GithubStats?
  userStats   UserProjectStats[]

  @@index([email])
  @@index([username])
}

model GithubStats {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastCommit          Json?
  lastCommitFetchedAt DateTime?
  totalStars          Int
  totalRepositories   Int
  totalPRs            Int
  topLanguages        Json?
  updatedAt           DateTime? @updatedAt
}

// Estatísticas detalhadas do usuário em relação a um projeto específico
model UserProjectStats {
  id Int @id @default(autoincrement())

  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Métricas de Código
  commitsCount Int @default(0) // Quantidade de commits do usuário
  linesAdded   Int @default(0) // Linhas adicionadas (via git log)
  linesDeleted Int @default(0) // Linhas deletadas (via git log)

  // Métricas de Tempo/Frequência
  firstCommitDate DateTime? // Data do primeiro commit nesse projeto
  lastCommitDate  DateTime? // Data do último commit nesse projeto
  activeDays      Int       @default(0) // Quantos dias diferentes o usuário commitou

  // Métricas de Impacto
  impactScore Float @default(0) // Um score calculado (ex: complexidade * volume) - futuro

  updatedAt DateTime @updatedAt

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Follows {
  follower    User     @relation("follower", fields: [followerId], references: [id])
  followerId  Int
  following   User     @relation("following", fields: [followingId], references: [id])
  followingId Int
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model GithubAppInstallation {
  id             Int    @id @default(autoincrement())
  installationId String @unique
  accountLogin   String
  accountType    String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime? // Null = Ativo, DateTime = Usado

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ProjectStatus {
  PENDING
  ANALYZING
  DONE
  ERROR
  RATE_LIMITED
}

model Project {
  id                Int    @id @default(autoincrement())
  title             String
  description       String
  longerDescription String

  images String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repositoryId Int?
  repository   Repository? @relation(fields: [repositoryId], references: [id])

  isPinned Boolean @default(false)

  status   ProjectStatus       @default(PENDING)
  analysis RepositoryAnalysis?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tags Tag[]

  likes        Like[]
  views        Int           @default(0)
  projectViews ProjectView[]

  userStats UserProjectStats[]
}

model Like {
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Chave composta para garantir que um usuário só pode curtir um projeto uma vez
  @@id([userId, projectId])
  // Index para contar likes de um projeto rapidamente
  @@index([projectId])
}

model Repository {
  id Int @id @default(autoincrement())

  githubId Int    @unique
  name     String
  fullName String
  url      String

  private Boolean

  isActive Boolean @default(true)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model RepositoryAnalysis {
  id Int @id @default(autoincrement())

  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  appType     String
  stack       Json
  structure   Json?
  signals     Json?
  rawAnalysis Json?
  llmOverview String? @db.Text

  createdAt DateTime @default(now())
}

model Certification {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  issuer        String
  credentialUrl String?
  issuedAt      DateTime

  image String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tags Tag[]
}

model Participation {
  id          Int    @id @default(autoincrement())
  title       String
  description String

  images String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  tags Tag[]
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  projects       Project[]
  certifications Certification[]
  participations Participation[]
}

model Education {
  id          Int       @id @default(autoincrement())
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime? // Null means "In Progress"

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProjectView {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String? // Para usuários não logados
  createdAt DateTime @default(now())

  @@index([projectId, userId])
  @@index([projectId, ipAddress])
}
