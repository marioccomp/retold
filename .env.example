# Copy this file to `.env` and replace every `CHANGE_ME_*` placeholder.
# Never commit the real `.env`.

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=retold_local
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_DB=retold_local
DATABASE_URL="postgresql://retold_local:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/retold_local"

# Auth / session
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="CHANGE_ME_AUTH_SECRET_MIN_32_BYTES"
APP_URL="http://localhost:3000"
ADDITIONAL_ALLOWED_ORIGINS=""

# Redis / rate limiting
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="CHANGE_ME_UPSTASH_REDIS_TOKEN"
REDIS_HOST=localhost
REDIS_PORT=6379

# Email
RESEND_API_KEY="CHANGE_ME_RESEND_API_KEY"

# GitHub OAuth (NextAuth sign-in)
AUTH_GITHUB_ID="CHANGE_ME_GITHUB_OAUTH_CLIENT_ID"
AUTH_GITHUB_SECRET="CHANGE_ME_GITHUB_OAUTH_CLIENT_SECRET"

# GitHub OAuth (explicit link flow)
GITHUB_LINK_CLIENT_ID="CHANGE_ME_GITHUB_LINK_CLIENT_ID"
GITHUB_LINK_CLIENT_SECRET="CHANGE_ME_GITHUB_LINK_CLIENT_SECRET"

# GitHub App
GITHUB_APP_ID="CHANGE_ME_GITHUB_APP_ID"
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME_GITHUB_APP_PRIVATE_KEY\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="CHANGE_ME_GITHUB_WEBHOOK_SECRET"

# AI provider
GROQ_API_KEY="CHANGE_ME_GROQ_API_KEY"
# LLM used by the analysis worker (services/worker/llm). Provider default: groq.
# LLM_PROVIDER="groq"
# LLM_MODEL="openai/gpt-oss-120b"

# Storage (local MinIO example)
MINIO_ROOT_USER=retold-minio-root
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=auto
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=retold
MINIO_PUBLIC_URL=http://localhost:9000

# Storage (Cloudflare R2 example)
# MINIO_ENDPOINT=<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
# MINIO_PORT=
# MINIO_USE_SSL=true
# MINIO_REGION=auto
# MINIO_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY
# MINIO_SECRET_KEY=CHANGE_ME_R2_SECRET_KEY
# MINIO_BUCKET=retold
# MINIO_PUBLIC_URL=https://cdn.example.com

# Analytics
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_CLARITY_ID=""
