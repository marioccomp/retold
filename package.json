{
  "name": "retold-monorepo",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:full": "pnpm db:start && pnpm dev",
    "setup": "pnpm postinstall",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:start": "pnpm db:up && pnpm db:migrate",
    "db:rebuild": "pnpm db:reset && pnpm db:migrate",
    "db:studio": "pnpm --filter @repo/database exec prisma studio",
    "db:migrate": "pnpm --filter @repo/database exec prisma migrate dev",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:push": "pnpm --filter @repo/database exec prisma db push"
  },
  "devDependencies": {
    "turbo": "^2.7.0"
  }
}
