# Google Drive remote already configured with `rclone config` on the VPS.
BACKUP_GOOGLE_DRIVE_REMOTE=retold-gdrive
BACKUP_GOOGLE_DRIVE_PATH=retold-production

# Docker Compose file and service names.
BACKUP_COMPOSE_FILE=compose.prod.yaml
BACKUP_POSTGRES_SERVICE=database
BACKUP_REDIS_SERVICE=redis

# Redis is optional because, in this project, it is mainly used for workers/queues.
BACKUP_REDIS=false

# Keep the last N days of snapshots in Google Drive.
BACKUP_RETENTION_DAYS=14

# Temporary working directory on the VPS.
BACKUP_TMP_DIR=/tmp

# Writes the latest successful snapshot id to latest.txt.
BACKUP_WRITE_LATEST_MARKER=true
